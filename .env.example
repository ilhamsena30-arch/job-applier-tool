# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env.
# ============================================================

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash supports vision (used for PDF -> JSON and screenshot reading).
# deepseek-v4-pro does NOT support vision; use it only for hard reasoning.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# --- Gmail (send + receive) ---
# Requires 2FA enabled + an "App Password" from https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Google Sheets tracker ---
# Path to a service-account JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# The ID of your Google Sheet (from the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=

# --- Data paths ---
RESUME_PDF_PATH=data/resume.pdf
RESUME_JSON_PATH=data/resume.json
RECORDINGS_DIR=recordings

# --- Behaviour ---
# Auto-apply only when the match score is >= this value (0-100).
CONFIDENCE_THRESHOLD=75.0
# Conservative daily application cap (raise it once you feel safe).
DAILY_RATE_LIMIT=10
# Show the browser window (headful) so you can watch it work.
HEADED=true
