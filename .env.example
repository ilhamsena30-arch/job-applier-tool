# ============================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the real .env.
# ============================================================

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-flash supports vision (used for PDF -> JSON and screenshot reading).
# deepseek-v4-pro does NOT support vision; use it only for hard reasoning.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_MODEL=deepseek-v4-pro

# --- Gmail (send + receive) ---
# Requires 2FA enabled + an "App Password" from https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# --- Google Sheets tracker ---
# Path to a service-account JSON downloaded from Google Cloud Console.
GOOGLE_CREDENTIALS_FILE=credentials.json
# The ID of your Google Sheet (from the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit)
SPREADSHEET_ID=

# --- Data paths ---
# Resume PDF: leave BLANK to auto-discover. The agent looks in RESUME_DIR for any
# PDF whose filename contains "resume" (case-insensitive), e.g.
#   data/Resume-Your_Name.pdf  -> matched
# Newest wins, and stale duplicates are deleted so one PDF remains.
# Set a path only to pin a specific file and skip discovery/cleanup.
RESUME_PDF_PATH=
# Directory scanned for the resume PDF (relative to the project root).
RESUME_DIR=data
# Structured resume written by extraction; always this name (internal artifact).
RESUME_JSON_PATH=data/resume.json
RECORDINGS_DIR=recordings

# --- Behaviour ---
# Auto-apply only when the match score is >= this value (0-100).
CONFIDENCE_THRESHOLD=75.0
# Hard cap on applications submitted per day (enforced by `agent auto`).
DAILY_RATE_LIMIT=10
# Show the browser window (headful) so you can watch it work.
HEADED=true
# Browser engine: auto | aihawk | playwright
#   auto      -> prefer AIHawk anti-detect engine, fall back to plain Chromium
#   aihawk    -> require the AIHawk engine (install: pip install invisible-playwright)
#   playwright-> plain Playwright Chromium
BROWSER_ENGINE=auto

# --- Auto runner (`python -m agent auto`) ---
# Job titles to search for, separated by '|'.
SEARCH_QUERIES=SDET|QA Automation Engineer|Test Automation Engineer
# Location passed to the job boards (leave blank for remote/anywhere).
SEARCH_LOCATION=
# How many jobs to pull from each board per query.
SEARCH_LIMIT=10
# Submit applications automatically. Set to false to fill forms WITHOUT
# submitting (a safe rehearsal — nothing is sent).
AUTO_SUBMIT=true
# Hours to sleep between batches when running with --loop.
LOOP_INTERVAL_HOURS=6.0
